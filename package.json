{
  "name": "framecast",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop screen recorder and intelligent video editor",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @framecast/desktop",
    "build": "npm run build -w @framecast/desktop",
    "typecheck": "tsc -b tsconfig.json && npm run typecheck -w @framecast/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.10.1",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "prettier": "3.4.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vitest": "2.1.8"
  },
  "type": "module"
}